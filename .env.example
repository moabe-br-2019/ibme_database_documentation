# Configuração da API do Bubble.io
# Nome do app Bubble (ex: se a URL é "meuapp.bubbleapps.io", use "meuapp")
BUBBLE_APP_NAME=seu-app-name

# Token de API do Bubble (gerar em: Settings > API > Generate API token)
BUBBLE_API_TOKEN=seu-token-aqui

# Configuração do Supabase
# URL do projeto Supabase (ex: https://xxx.supabase.co)
SUPABASE_URL=https://seu-projeto.supabase.co

# Service Role Key do Supabase (encontre em: Settings > API > service_role key)
# ⚠️ ATENÇÃO: Nunca compartilhe esta chave publicamente!
SUPABASE_SERVICE_KEY=sua-service-key-aqui
